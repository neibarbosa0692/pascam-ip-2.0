<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PasCam theme retains the original tested Material styling. -->
    <style name="Theme.PasCamIP" parent="Theme.MaterialComponents.Light.DarkActionBar.Bridge">
        <!-- Black window behind the full-screen preview, so the layout does not paint it twice. -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Settings follows the system light/dark setting (DayNight), while the rest of the
         app keeps its fixed light theme. -->
    <style name="Theme.PasCamIP.Settings" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge" />
</resources>